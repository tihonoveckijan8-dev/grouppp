{
  "id": "./",
  "name": "BandPlan — Music Group OS",
  "short_name": "BandPlan",
  "description": "Расписание, репертуар, сет-листы и сценический режим для музыкальной группы. Работает офлайн.",
  "lang": "ru",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#D9D3EA",
  "theme_color": "#2547D0",
  "categories": ["music", "productivity"],
  "shortcuts": [
    { "name": "Календарь", "short_name": "Календарь", "url": "./#/calendar", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Песни", "short_name": "Песни", "url": "./#/songs", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
